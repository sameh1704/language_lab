msgstr "Connection to the teacher was lost..."
msgid "تعذر الربط"
msgstr "Could not pair"

msgid "الصوت: يعمل"
msgstr "Audio: on"
msgid "إيقاف الصوت"
msgstr "Turn audio off"
msgid "البث يصل إلى %(count)s جهاز"
msgstr "Broadcasting to %(count)s device(s)"
msgid "البث يصل إلى %(ready)s من %(selected)s جهاز محدد"
