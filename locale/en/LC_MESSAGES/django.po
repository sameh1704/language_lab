msgstr "Teacher computer network address: %(ips)s"
msgid "، "
msgstr ", "
msgid "لم يُعثر على عنوان شبكة لجهاز المعلم"
msgstr "No network address was found for the teacher computer"
msgid "تأكد أن الجهاز موصول بشبكة المعمل."
msgstr "Make sure the computer is connected to the lab network."
msgid "اللوحة مفتوحة من localhost، فالميكروفون متاح"
msgstr "The dashboard is open from localhost, so the microphone is available"
msgid "اللوحة مفتوحة من عنوان الشبكة، والمتصفح سيمنع الميكروفون"
msgstr "The dashboard is open using a network address; the browser will block the microphone"
msgid "افتحها من http://localhost:"
msgstr "Open it at http://localhost:"
msgid "Veyon: الوضع التجريبي مفعّل"
msgstr "Veyon: simulation mode is enabled"
msgid "اضبط LAB_SIMULATE=0 للتشغيل الفعلي."
msgstr "Set LAB_SIMULATE=0 for live operation."
msgid "veyon-cli موجود على جهاز المعلم"
msgstr "veyon-cli is available on the teacher computer"
msgid "veyon-cli غير موجود"
msgstr "veyon-cli was not found"
msgid "ثبّت Veyon أو صحّح المسار في VEYON_CLI (الحالي: %(path)s)"
msgstr "Install Veyon or correct the VEYON_CLI path (current: %(path)s)"
msgid "%(count)s جهاز بدون عنوان IP"
msgstr "%(count)s device(s) without an IP address"
