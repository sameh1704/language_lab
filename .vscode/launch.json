{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: تشغيل محلي (محاكاة)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\manage.py",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "runserver",
        "0.0.0.0:8000",
        "--noreload"
      ],
      "django": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "labsys.settings",
        "LAB_SIMULATE": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
